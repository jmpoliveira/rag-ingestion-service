# Copy to .env and adjust. .env is git-ignored: never commit real values.
# An empty value counts as "not set". Environment variables override this file.

# --- Application -------------------------------------------------------------------------
APP_NAME=rag-ingestion-service
APP_ENV=development              # development | test | production: selects the logging profile
# LOG_LEVEL=DEBUG                # optional: overrides the profile's root level

# --- Source (ADR 0002) -------------------------------------------------------------------
# Folder to ingest (required, never created). Supported: .pdf, .md, .markdown, .txt.
SOURCE_DIR=samples/knowledge-base
MAX_FILE_BYTES=26214400          # 25 MiB: larger files are reported as failed
MAX_PDF_PAGES=500
# Remove from the index the documents that left the folder. Never applied when the folder is
# empty: a wrong path must not wipe the index (use `make reset CONFIRM=yes` on purpose).
DELETE_MISSING=true

# --- Chunking ------------------------------------------------------------------------------
# Changing these re-ingests every document on the next sync (they are part of its version).
CHUNK_SIZE=1000
CHUNK_OVERLAP=200

# --- Embeddings (part of the index contract, ADR 0004) -----------------------------------
OLLAMA_BASE_URL=http://localhost:11434
# The model must be pulled first: ollama pull nomic-embed-text
EMBEDDING_MODEL=nomic-embed-text
# Task prefixes. nomic-embed-text was trained with "search_document: " / "search_query: ";
# leave both empty for models without them. Changing them needs a new collection.
EMBEDDING_DOCUMENT_PREFIX=
EMBEDDING_QUERY_PREFIX=
EMBEDDING_BATCH_SIZE=32
EMBEDDING_TIMEOUT_SECONDS=60
EMBEDDING_MAX_ATTEMPTS=3
EMBEDDING_RETRY_BASE_DELAY_SECONDS=0.5
EMBEDDING_RETRY_MAX_DELAY_SECONDS=8

# --- Vector store (docker-env service contract: CHROMA_HOST / CHROMA_PORT) ----------------
CHROMA_HOST=localhost
CHROMA_PORT=8001                 # docker-env publishes Chroma on 8001 (8000 inside the network)
CHROMA_SSL=false
CHROMA_COLLECTION=knowledge-base
CHROMA_DISTANCE=cosine           # cosine | l2 | ip; fixed when the collection is created
CHROMA_BATCH_SIZE=100

# --- OpenTelemetry (OTLP over HTTP; standard variable names) ------------------------------
OTEL_ENABLED=false
# The docker-env collector, which fans traces out to Jaeger and Phoenix. /v1/traces is appended.
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_SERVICE_NAME=rag-ingestion-service

# --- Eval results viewer (only `python -m evals`; see ADR 0005) ---------------------------
PHOENIX_BASE_URL=http://localhost:6006
# Only if the Phoenix server has authentication enabled (docker-env disables it locally).
PHOENIX_API_KEY=
PHOENIX_REQUEST_TIMEOUT_SECONDS=30
